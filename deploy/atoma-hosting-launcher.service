[Unit]
Description=Atoma persistent application launcher
After=docker.service
Requires=docker.service
RequiresMountsFor=/home/atoma

[Service]
Type=simple
User=atoma
Group=atoma
EnvironmentFile=/home/atoma/config/hosting.env
ExecStart=/usr/bin/node /home/atoma/current/dist/launcher/hostingMain.js
ExecStartPost=/usr/bin/node -e "const net=require('node:net');const end=Date.now()+20000;function probe(){const s=net.createConnection(process.env.ATOMA_HOSTING_SOCKET);s.on('connect',()=>{s.end();process.exit(0)});s.on('error',()=>Date.now()<end?setTimeout(probe,100):process.exit(1))}probe()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/atoma/hosting /home/atoma/hosting-control
UMask=0077

[Install]
WantedBy=multi-user.target
