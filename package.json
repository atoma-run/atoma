{
  "name": "atoma",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://atoma.run",
  "type": "module",
  "description": "Three-tier LLM agent orchestration with persisted types, earned trust, and symmetric supervision",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:workspace-service && npm run build:compute-retrieval && npm run build:compute-preview && npm run build:preview-terminal && npm run mcp:build && npm run viz:build",
    "launcher": "node dist/launcher/main.js",
    "launcher:dev": "tsx src/launcher/main.ts",
    "build:web": "docker build -f docker/web.Dockerfile -t atoma-web:latest .",
    "build:web:dev": "npm run build && npm run build:web",
    "stack:check": "node scripts/stack-check.mjs",
    "build:launcher": "docker build -f docker/launcher.Dockerfile -t atoma-launcher:latest .",
    "build:worker": "docker build -f docker/worker.Dockerfile -t atoma-worker:latest .",
    "build:worker:dev": "npm run build && npm run build:worker",
    "build:preview": "docker build -f docker/preview.Dockerfile -t atoma-preview:latest .",
    "build:preview:dev": "npm run build:preview-terminal && node scripts/build-compute-preview.mjs --source && npm run build:preview",
    "build:preview-terminal": "node scripts/build-preview-terminal.mjs",
    "preview:smoke:terminal": "node scripts/preview-terminal-smoke.mjs",
    "preview:demo": "tsx scripts/preview-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/atoma/tsc-build.tsbuildinfo && tsc -p tsconfig.all.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/atoma/tsc-all.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/atoma/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/atoma/eslint/",
    "check": "npm run docs:check && npm run typecheck && npm run lint && npm test",
    "check:changed": "node scripts/check-changed.mjs",
    "docs:check": "node scripts/check-agent-docs.mjs && node scripts/readme-facts.mjs && node scripts/architecture-ir.mjs",
    "docs:facts": "node scripts/readme-facts.mjs",
    "docs:architecture": "node scripts/architecture-ir.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node dist/cli/doctor.js",
    "doctor:dev": "tsx src/cli/doctor.ts",
    "haystack:config": "node dist/cli/haystackConfig.js",
    "haystack:config:dev": "tsx src/cli/haystackConfig.ts",
    "deploy:preflight": "node dist/cli/deploy-preflight.js",
    "auth": "node dist/cli/auth.js",
    "auth:dev": "tsx src/cli/auth.ts",
    "projects": "node dist/cli/projects.js",
    "projects:dev": "tsx src/cli/projects.ts",
    "sentinel": "node dist/cli/sentinel.js",
    "sentinel:dev": "tsx src/cli/sentinel.ts",
    "analyst": "node dist/cli/analyst.js",
    "analyst:dev": "tsx src/cli/analyst.ts",
    "mender": "node dist/cli/mender.js",
    "mender:dev": "tsx src/cli/mender.ts",
    "assayer": "node dist/cli/assayer.js",
    "assayer:dev": "tsx src/cli/assayer.ts",
    "release:check": "npm run release:check:static && npm test",
    "release:check:static": "npm run docs:check && npm run typecheck && npm run lint && npm audit && npm run build && npm run application:skeleton:smoke && node scripts/release-smoke.mjs && node scripts/auth-release-smoke.mjs && npm run auth -- --help && npm run doctor -- --help && npm run analyst -- --help && npm run mender -- --help && npm run assayer -- --help && npm run backup -- --help && npm run projects:maintenance -- --help && npm run settings -- --help && npm run compute -- --help && npm run latency -- --help",
    "settings": "node dist/cli/settings.js",
    "settings:dev": "tsx src/cli/settings.ts",
    "release:container-smoke": "node scripts/release-container-smoke.mjs",
    "run:build": "node dist/cli/build-app.js",
    "run:build:dev": "tsx src/cli/build-app.ts",
    "registry": "tsx src/cli/registry.ts",
    "models": "tsx src/cli/models.ts",
    "burnin": "tsx src/cli/burnin.ts",
    "curriculum": "tsx src/cli/curriculum.ts",
    "skills": "tsx src/cli/skills.ts",
    "viz": "node --import tsx scripts/viz-dev.mjs",
    "viz:dev": "node --import tsx scripts/viz-dev.mjs",
    "viz:gpu": "node --import tsx scripts/viz-dev.mjs",
    "viz:build": "node scripts/viz-build.mjs",
    "viz:shot": "node --import tsx scripts/viz-screenshot.mjs",
    "viz:smoke": "npm run build && node scripts/mcp-oauth-browser-smoke.mjs && node scripts/compute-browser-smoke.mjs && node scripts/viz-gpu-smoke.mjs",
    "viz:smoke:gc": "node scripts/viz-gpu-gc-smoke.mjs",
    "viz:mark-turn": "node scripts/viz-mark-turn.mjs",
    "viz:loading-crystal": "node scripts/viz-loading-crystal.mjs",
    "viz:mark-turn:analyze": "python3 scripts/viz-mark-turn-analyze.py",
    "viz:frame-probe": "node scripts/viz-frame-probe.mjs",
    "viz:serve": "node dist/viz/server.js",
    "viz:demo": "tsx src/viz/demo.ts",
    "ledger": "tsx src/cli/ledger.ts",
    "friction": "tsx src/cli/friction.ts",
    "backup": "node dist/cli/backup.js",
    "projects:maintenance": "node dist/cli/projects-maintenance.js",
    "projects:maintenance:dev": "tsx src/cli/projects-maintenance.ts",
    "backup:dev": "tsx src/cli/backup.ts",
    "benchmark:models": "tsx src/cli/compareModels.ts",
    "latency": "node dist/cli/latency.js",
    "latency:dev": "tsx src/cli/latency.ts",
    "benchmark": "tsx src/cli/benchmark.ts",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:translate": "node scripts/i18n.mjs translate",
    "prepare": "node scripts/husky-install.mjs",
    "viz:smoke:files": "node scripts/file-viewer-smoke.mjs",
    "mcp:build": "node scripts/build-mcp-app.mjs",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp-app-browser-smoke.mjs",
    "build:hosting:browser": "docker build -f docker/hosting-browser.Dockerfile -t atoma-hosted-browser:latest .",
    "build:hosting": "docker build -f docker/hosting.Dockerfile -t atoma-hosting:latest .",
    "application:skeleton:smoke": "node scripts/application-skeleton-smoke.mjs",
    "build:workspace-service": "node scripts/build-workspace-service.mjs",
    "build:workspace": "docker build -f docker/workspace.Dockerfile -t atoma-workspace:latest .",
    "compute": "node dist/cli/compute.js",
    "compute:dev": "tsx src/cli/compute.ts",
    "build:compute-retrieval": "node scripts/build-compute-retrieval.mjs",
    "build:compute-preview": "node scripts/build-compute-preview.mjs",
    "compute:desktop:build": "node scripts/build-compute-desktop.mjs",
    "compute:desktop": "npm run compute:desktop:build && electron dist/compute-desktop",
    "compute:desktop:package": "npm run compute:desktop:build && electron-builder --config desktop/electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "better-sqlite3": "13.0.3",
    "fflate": "^0.8.3",
    "i18next": "^25.10.10",
    "jsonrepair": "^3.14.0",
    "officeparser": "7.8.0",
    "openai": "^7.10.0",
    "puppeteer": "^25.16.0",
    "three": "^0.185.1",
    "typescript": "5.9.3",
    "ws": "8.21.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    },
    "esbuild": "$esbuild",
    "officeparser": {
      "pdfjs-dist": "6.2.108"
    },
    "mammoth": {
      "argparse": "2.0.1"
    },
    "mermaid": {
      "katex": "0.18.2"
    },
    "mpegts.js": {
      "webworkify-webpack": "2.1.5"
    },
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@headlessui/react": "^2.2.10",
    "@mlightcad/libredwg-web": "0.7.4",
    "@modelcontextprotocol/client": "^2.3.0",
    "@open-file-viewer/core": "0.1.49",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.13.3",
    "@types/prismjs": "1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "echarts": "^6.1.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "marked": "18.1.0",
    "mpegts.js": "1.8.0",
    "pdfjs-dist": "6.2.108",
    "pixi.js": "^8.19.0",
    "prismjs": "1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.4",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
