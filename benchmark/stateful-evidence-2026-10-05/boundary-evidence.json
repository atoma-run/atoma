      "result": {
        "path": "test/library.test.js",
        "content": "'use strict';\nconst testApi=require('node:test');\nconst test=(name,fn)=>testApi(name,{concurrency:false},fn);\ntest.before=testApi.before;\ntest.after=testApi.after;\nconst assert=require('node:assert/strict');\nconst fs=require('node:fs');\nconst os=require('node:os');\nconst path=require('node:path');\nconst {spawn}=require('node:child_process');\n\nlet dir, dataFile, child, base;\nasync function request(method,pathName,body,headers={}){\n  const r=await fetch(base+pathName,{method,headers:{'content-type':'application/json','X-Today':'2026-01-01',...headers},body:body===undefined?undefined:JSON.stringify(body)});\n  return {status:r.status,json:await r.json()};\n}\n\ntest.before(async()=>{\n  dir=fs.mkdtempSync(path.join(os.tmpdir(),'library-test-'));\n  dataFile=path.join(dir,'library.json');\n  child=spawn(process.execPath,['server.js'],{env:{...process.env,PORT:'0',DATA_FILE:dataFile},stdio:['ignore','pipe','inherit']});\n  let output='';\n  await new Promise((resolve,reject)=>{\n    child.stdout.on('data',chunk=>{output+=chunk;const m=output.match(/LISTENING_ON_PORT=(\\d+)/);if(m){base='http://127.0.0.1:'+m[1];resolve();}});\n    child.once('error',reject);\n    setTimeout(()=>reject(new Error('server timeout')),5000);\n  });\n});\ntest.after(()=>{if(child)child.kill('SIGTERM');fs.rmSync(dir,{recursive:true,force:true});});\n\ntest('initial views and static UI',async()=>{\n  let r=await request('GET','/api/books');assert.equal(r.status,200);assert.equal(r.json.length,6);assert.ok(r.json.every(b=>Number.isInteger(b.availableCopies)));\n  r=await request('GET','/api/members');assert.equal(r.status,200);assert.equal(r.json.length,3);\n  r=await request('GET','/api/members/m1');assert.equal(r.status,200);assert.deepEqual(r.json.activeLoans,[]);\n  const ui=await fetch(base+'/');assert.equal(ui.status,200);assert.match(await ui.text(),/Neighbourhood Library/);\n});\n\ntest('validation, loan dates, availability and unknown resources',async()=>{\n  let r=await request('POST','/api/loans',{});assert.equal(r.status,400);\n  r=await request('POST','/api/loans',{bookId:' ',memberId:'m1'});assert.equal(r.status,400);\n  r=await request('POST','/api/loans',{bookId:'missing',memberId:'m1'});assert.equal(r.status,404);\n  r=await request('POST','/api/loans',{bookId:'b2',memberId:'m1'});assert.equal(r.status,201);assert.equal(r.json.dueDate,'2026-01-15');\n  r=await request('POST','/api/loans',{bookId:'b2',memberId:'m2'});assert.equal(r.status,409);\n});\n\ntest('holds, reservation, oldest ordering and return fine cap',async()=>{\n  let r=await request('POST','/api/holds',{bookId:'b2',memberId:'m2'});assert.equal(r.status,201);\n  r=await request('POST','/api/holds',{bookId:'b2',memberId:'m3'});assert.equal(r.status,201);\n  r=await request('POST','/api/holds',{bookId:'b1',memberId:'m1'});assert.equal(r.status,409);\n  r=await request('POST','/api/loans/l1/renew');assert.equal(r.status,409);\n  r=await request('POST','/api/loans/l1/return',undefined,{'X-Today':'2026-03-01'});assert.equal(r.status,200);assert.equal(r.json.fineCents,1000);\n  r=await request('POST','/api/loans',{bookId:'b2',memberId:'m3'});assert.equal(r.status,409);\n  r=await request('POST','/api/loans',{bookId:'b2',memberId:'m2'});assert.equal(r.status,201);assert.equal(r.json.memberId,'m2');\n  r=await request('GET','/api/members/m2');assert.equal(r.status,200);assert.equal(r.json.holds.length,0);\n});\n\ntest('renewal, limits, payments and fine threshold',async()=>{\n  let r=await request('POST','/api/loans',{bookId:'b3',memberId:'m3'});assert.equal(r.status,201);const renewalId=r.json.id;\n  r=await request('POST','/api/loans/'+renewalId+'/renew');assert.equal(r.status,200);\n  r=await request('POST','/api/loans/'+renewalId+'/renew');assert.equal(r.status,200);\n  r=await request('POST','/api/loans/'+renewalId+'/renew');assert.equal(r.status,409);\n  const premiumLoans=[renewalId];\n  for(const bookId of ['b1','b4','b5','b6']) { r=await request('POST','/api/loans',{bookId,memberId:'m3'});assert.equal(r.status,201);premiumLoans.push(r.json.id); }\n  r=await request('POST','/api/loans',{bookId:'b2',memberId:'m3'});assert.equal(r.status,409);\n  for(const id of premiumLoans) { r=await request('POST','/api/loans/'+id+'/return',undefined,{'X-Today':'2026-01-01'});assert.equal(r.status,200); }\n  r=await request('POST','/api/members/m1/payments',{amount:10});assert.equal(r.status,201);assert.equal(r.json.amountCents,1000);\n  r=await request('POST','/api/members/m1/payments',{amount:0.01});assert.equal(r.status,201);assert.equal(r.json.amountCents,1);\n  r=await request('POST','/api/members/m1/payments',{amount:'1'});assert.equal(r.status,400);\n  r=await request('GET','/api/members/m1');assert.equal(r.status,200);assert.equal(r.json.finesOwedCents,0);\n});\n\ntest('standard loan limit and unpaid-fine refusal',async()=>{\n  let r=await request('POST','/api/loans',{bookId:'b4',memberId:'m1'});assert.equal(r.status,201);const firstLoan=r.json.id;\n  r=await request('POST','/api/loans',{bookId:'b5',memberId:'m1'});assert.equal(r.status,201);\n  r=await request('POST','/api/loans',{bookId:'b6',memberId:'m1'});assert.equal(r.status,201);\n  r=await request('POST','/api/loans',{bookId:'b1',memberId:'m1'});assert.equal(r.status,409);\n  r=await request('POST','/api/loans/'+firstLoan+'/return',undefined,{'X-Today':'2026-03-01'});assert.equal(r.status,200);\n});\n\ntest('fine threshold and premium limit',async()=>{\n  let r=await request('POST','/api/loans',{bookId:'b1',memberId:'m2'});assert.equal(r.status,201);\n  r=await request('POST','/api/loans/'+r.json.id+'/return',undefined,{'X-Today':'2026-01-16'});assert.equal(r.status,200);assert.equal(r.json.fineCents,25);\n  r=await request('POST','/api/members/m2/payments',{amount:0.01});assert.equal(r.status,201);\n  r=await request('POST','/api/loans',{bookId:'b4',memberId:'m2'});assert.equal(r.status,201);\n  r=await request('POST','/api/loans/'+r.json.id+'/return',undefined,{'X-Today':'2026-03-01'});assert.equal(r.status,200);assert.equal(r.json.fineCents,1000);\n  r=await request('POST','/api/loans',{bookId:'b1',memberId:'m2'});assert.equal(r.status,409);\n  r=await request('POST','/api/members/m2/payments',{amount:10.25});assert.equal(r.status,201);\n  r=await request('POST','/api/loans',{bookId:'b1',memberId:'m2'});assert.equal(r.status,201);\n  const m1=await request('GET','/api/members/m1');\n  for(const loan of m1.json.activeLoans) { r=await request('POST','/api/loans/'+loan.id+'/return',undefined,{'X-Today':'2026-01-01'});assert.equal(r.status,200); }\n  for(const bookId of ['b1','b3','b4','b5','b6']) { r=await request('POST','/api/loans',{bookId,memberId:'m3'});assert.equal(r.status,201); }\n  r=await request('POST','/api/loans',{bookId:'b6',memberId:'m3'});assert.equal(r.status,409);\n});\n\ntest('malformed, missing loan and unknown route',async()=>{\n  let r=await fetch(base+'/api/loans',{method:'POST',headers:{'content-type':'application/json'},body:'not json'});assert.equal(r.status,400);\n  r=await request('POST','/api/loans/nope/return');assert.equal(r.status,404);\n  r=await request('GET','/api/members/nope');assert.equal(r.status,404);\n  r=await request('GET','/api/nope');assert.equal(r.status,404);\n  assert.ok(fs.existsSync(dataFile));assert.doesNotThrow(()=>JSON.parse(fs.readFileSync(dataFile,'utf8')));\n});\n"
      },
